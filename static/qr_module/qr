<!-- === BẮT ĐẦU PHẦN 2: TRẠM ĐỌC MÃ QR MASTER ENTERPRISE === -->
<script src="{{ url_for('static', filename='vendor/jsQR.js') }}"></script>

<div class="card border-0 shadow-lg mb-4 rounded-4 overflow-hidden" id="single-qr-section">
    <!-- Header Gradient Master -->
    <div class="card-header bg-gradient bg-primary text-white p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-white text-primary rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                <span class="fs-5">🚀</span>
            </div>
            <div>
                <h5 class="mb-0 fw-bold">Smart Logistics - Master QR Station</h5>
                <small class="text-white-50">He thong xac thuc & quan ly ma don hang tu dong</small>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Nút bật tắt Dark Mode mini -->
            <button id="themeToggleBtn" class="btn btn-sm btn-outline-light rounded-pill px-2" title="Chuyen doi sang/toi">🌙 Dark</button>
            <div class="form-check form-switch mb-0 text-white" title="Am thanh phan hoi">
                <input class="form-check-input" type="checkbox" id="soundToggle" checked style="cursor: pointer;">
                <label class="form-check-label small fw-semibold" for="soundToggle">🔊 Am bao</label>
            </div>
            <span class="badge bg-light text-primary px-3 py-2 rounded-pill shadow-sm" id="qrFileStatus">San sang</span>
        </div>
    </div>

    <div class="card-body p-4 bg-light" id="cardBodyContainer">
        <!-- Thong ke nhanh -->
        <div class="row g-2 mb-3 text-center">
            <div class="col-3">
                <div class="p-2 bg-white rounded-3 shadow-sm border">
                    <small class="text-muted d-block" style="font-size: 0.65rem;">TONG QUET</small>
                    <span class="fw-bold fs-6 text-dark" id="statTotal">0</span>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 bg-white rounded-3 shadow-sm border">
                    <small class="text-muted d-block" style="font-size: 0.65rem;">HOP LE (DH-)</small>
                    <span class="fw-bold fs-6 text-success" id="statValid">0</span>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 bg-white rounded-3 shadow-sm border">
                    <small class="text-muted d-block" style="font-size: 0.65rem;">KHAC</small>
                    <span class="fw-bold fs-6 text-warning" id="statOther">0</span>
                </div>
            </div>
            <div class="col-3">
                <div class="p-2 bg-white rounded-3 shadow-sm border">
                    <small class="text-muted d-block" style="font-size: 0.65rem;">LOI</small>
                    <span class="fw-bold fs-6 text-danger" id="statInvalid">0</span>
                </div>
            </div>
        </div>

        <!-- Thanh Tabs -->
        <ul class="nav nav-pills nav-fill mb-3 bg-white p-1 rounded-3 shadow-sm border" id="qrModeTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-bold rounded-2 py-2" id="tab-image-btn" data-bs-toggle="pill" data-bs-target="#pane-image" type="button" role="tab">
                    📁 Tai File Anh QR
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-bold rounded-2 py-2" id="tab-camera-btn" data-bs-toggle="pill" data-bs-target="#pane-camera" type="button" role="tab">
                    📷 Quet Camera Tu Dong
                </button>
            </li>
        </ul>

        <div class="tab-content" id="qrModeContent">
            <!-- TAB 1: TAI FILE ANH -->
            <div class="tab-pane fade show active" id="pane-image" role="tabpanel">
                <div id="dropZone" class="border border-2 border-dashed rounded-4 p-4 text-center mb-3 bg-white shadow-sm" style="cursor: pointer; transition: all 0.2s;">
                    <div class="mb-2"><span class="fs-1 text-primary">📥</span></div>
                    <label for="qrImageInput" class="form-label fw-bold mb-1 text-dark" style="cursor: pointer;">
                        Keo tha anh QR vao day hoac <span class="text-primary text-decoration-underline">chon tep tu may</span>
                    </label>
                    <p class="text-muted small mb-0">Ho tro PNG, JPG, WEBP (Tu dong giai ma ngay lap tuc)</p>
                    <input class="form-control d-none" type="file" id="qrImageInput" accept="image/png, image/jpeg, image/jpg, image/webp">
                </div>

                <!-- Preview Anh -->
                <div class="mb-3 text-center">
                    <div class="border rounded-4 bg-white p-3 shadow-sm position-relative" style="min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <img id="qrPreview" src="#" alt="Preview" style="max-width: 100%; max-height: 220px; display: none; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);" />
                        <span id="placeholderText" class="text-muted">🖼️ Khu vực hiển thị ảnh xem trước</span>
                        <small id="fileInfoText" class="text-secondary mt-2 d-none fw-semibold"></small>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-3">
                    <button id="clearQrBtn" class="btn btn-outline-secondary w-100 fw-semibold rounded-3 shadow-sm" type="button" disabled>
                        ✖ Lam moi khung lam việc
                    </button>
                </div>
            </div>

            <!-- TAB 2: QUÉT CAMERA -->
            <div class="tab-pane fade" id="pane-camera" role="tabpanel">
                <div class="text-center mb-3">
                    <div class="border rounded-4 bg-dark position-relative overflow-hidden mx-auto shadow-sm" style="max-width: 460px; min-height: 240px; display: flex; align-items: center; justify-content: center;">
                        <video id="qrVideo" class="w-100 h-100 d-none" playsinline style="object-fit: cover;"></video>
                        <canvas id="qrCameraCanvas" class="d-none"></canvas>
                        
                        <!-- Khung ngắm Laser Master -->
                        <div id="laserGuide" class="position-absolute w-75 h-75 border border-2 border-success rounded-3 d-none pointer-events-none" style="box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);">
                            <div class="w-100 bg-success opacity-75 position-absolute" style="height: 2px; animation: scanLaser 1.5s infinite linear;"></div>
                        </div>

                        <div id="cameraPlaceholder" class="text-white-50 p-4">
                            <span class="fs-1 d-block mb-2">📷</span>
                            <p class="mb-1 fw-semibold text-white">San sang quet qua Camera</p>
                            <small>Dua ma QR vao tam ngắm de he thong bat tu dong</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mb-3 justify-content-center">
                    <button id="startCamBtn" class="btn btn-success fw-bold px-4 py-2 shadow-sm rounded-3">
                        ▶ Bat Camera Quet Nhanh
                    </button>
                    <button id="stopCamBtn" class="btn btn-danger fw-bold px-4 py-2 shadow-sm rounded-3" disabled>
                        ⏹ Tat Camera
                    </button>
                </div>
            </div>
        </div>

        <!-- Khung Ket Qua -->
        <div id="scanResultAlert" class="alert d-none mb-3 align-items-center justify-content-between flex-wrap gap-2 rounded-3 shadow-sm" role="alert">
            <div id="alertContentText" class="flex-grow-1"></div>
            <div class="d-flex gap-2">
                <button id="copyResultBtn" class="btn btn-sm btn-dark px-3 fw-semibold d-none rounded-2 shadow-sm" type="button">📋 Sao chep</button>
            </div>
        </div>

        <!-- NHAT KY & XUAT BAO CAO -->
        <div class="border-top pt-3 mt-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="mb-0 fw-bold text-dark" id="historyTitle">📜 Nhat Ky Hoat Dong (<span id="historyCount">0</span>)</h6>
                <div class="d-flex gap-2">
                    <button id="exportHistoryBtn" class="btn btn-sm btn-outline-success rounded-2 px-2 d-none" title="Tai CSV">📥 CSV</button>
                    <button id="clearHistoryBtn" class="btn btn-sm btn-outline-danger rounded-2 px-2 d-none">Xoa</button>
                </div>
            </div>

            <div class="mb-2">
                <input type="text" id="searchHistoryInput" class="form-control form-control-sm rounded-2 bg-white" placeholder="🔍 Tim kiem ma don hang trong nhat ky...">
            </div>

            <ul id="scanHistoryList" class="list-group list-group-flush small border rounded-3 bg-white shadow-sm overflow-hidden" style="max-height: 140px; overflow-y: auto;">
                <li class="list-group-item text-muted text-center py-3">Chua ghi nhan ma nao</li>
            </ul>
        </div>
    </div>
</div>

<style>
@keyframes scanLaser {
    0% { top: 0%; }
    50% { top: 98%; }
    100% { top: 0%; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const qrImageInput = document.getElementById('qrImageInput');
    const dropZone = document.getElementById('dropZone');
    const qrPreview = document.getElementById('qrPreview');
    const placeholderText = document.getElementById('placeholderText');
    const fileInfoText = document.getElementById('fileInfoText');
    const qrFileStatus = document.getElementById('qrFileStatus');
    const clearQrBtn = document.getElementById('clearQrBtn');
    const scanResultAlert = document.getElementById('scanResultAlert');
    const alertContentText = document.getElementById('alertContentText');
    const copyResultBtn = document.getElementById('copyResultBtn');
    const soundToggle = document.getElementById('soundToggle');
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const cardBodyContainer = document.getElementById('cardBodyContainer');
    const historyTitle = document.getElementById('historyTitle');

    const startCamBtn = document.getElementById('startCamBtn');
    const stopCamBtn = document.getElementById('stopCamBtn');
    const qrVideo = document.getElementById('qrVideo');
    const qrCameraCanvas = document.getElementById('qrCameraCanvas');
    const cameraPlaceholder = document.getElementById('cameraPlaceholder');
    const laserGuide = document.getElementById('laserGuide');

    const scanHistoryList = document.getElementById('scanHistoryList');
    const historyCount = document.getElementById('historyCount');
    const clearHistoryBtn = document.getElementById('clearHistoryBtn');
    const exportHistoryBtn = document.getElementById('exportHistoryBtn');
    const searchHistoryInput = document.getElementById('searchHistoryInput');

    const statTotal = document.getElementById('statTotal');
    const statValid = document.getElementById('statValid');
    const statOther = document.getElementById('statOther');
    const statInvalid = document.getElementById('statInvalid');

    let lastDecodedText = '';
    let videoStream = null;
    let cameraScanInterval = null;
    let isDarkMode = false;
    const STORAGE_KEY = 'smart_logistics_qr_master_v4';

    // Toggle Dark Mode
    themeToggleBtn.addEventListener('click', function () {
        isDarkMode = !isDarkMode;
        if (isDarkMode) {
            cardBodyContainer.className = 'card-body p-4 bg-dark text-white';
            themeToggleBtn.className = 'btn btn-sm btn-warning rounded-pill px-2';
            themeToggleBtn.textContent = '☀️ Light';
            historyTitle.className = 'mb-0 fw-bold text-white';
        } else {
            cardBodyContainer.className = 'card-body p-4 bg-light text-dark';
            themeToggleBtn.className = 'btn btn-sm btn-outline-light rounded-pill px-2';
            themeToggleBtn.textContent = '🌙 Dark';
            historyTitle.className = 'mb-0 fw-bold text-dark';
        }
    });

    // Am thanh Master Beep
    function playBeepSound(type = 'success') {
        if (!soundToggle.checked) return;
        try {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            if (type === 'success') {
                oscillator.frequency.setValueAtTime(1200, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.08);
            } else {
                oscillator.frequency.setValueAtTime(180, audioCtx.currentTime);
                gainNode.gain.setValueAtTime(0.2, audioCtx.currentTime);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.2);
            }
        } catch (e) {
            console.log('Audio error:', e);
        }
    }

    function getStoredHistory() {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    }

    function updateStats() {
        const history = getStoredHistory();
        statTotal.textContent = history.length;
        statValid.textContent = history.filter(i => i.category === 'valid').length;
        statOther.textContent = history.filter(i => i.category === 'other').length;
        statInvalid.textContent = history.filter(i => i.category === 'invalid').length;
    }

    function renderHistory(filterText = '') {
        const history = getStoredHistory();
        updateStats();

        const filtered = history.filter(item => item.code.toLowerCase().includes(filterText.toLowerCase()));
        historyCount.textContent = history.length;

        if (history.length === 0) {
            scanHistoryList.innerHTML = '<li class="list-group-item text-muted text-center py-3">Chưa ghi nhận mã nào</li>';
            clearHistoryBtn.classList.add('d-none');
            exportHistoryBtn.classList.add('d-none');
            return;
        }

        clearHistoryBtn.classList.remove('d-none');
        exportHistoryBtn.classList.remove('d-none');

        if (filtered.length === 0) {
            scanHistoryList.innerHTML = '<li class="list-group-item text-muted text-center py-2">Không tìm thấy kết quả</li>';
            return;
        }

        scanHistoryList.innerHTML = filtered.map(item => {
            let badgeClass = 'bg-success';
            if (item.category === 'other') badgeClass = 'bg-warning text-dark';
            if (item.category === 'invalid') badgeClass = 'bg-danger';
            return `
                <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 ${isDarkMode ? 'bg-dark text-white border-secondary' : ''}">
                    <div class="text-truncate me-2">
                        <span class="badge ${badgeClass} me-1">${item.source}</span>
                        <strong class="${isDarkMode ? 'text-white' : 'text-dark'}">${item.code}</strong>
                    </div>
                    <small class="text-muted text-nowrap">${item.time}</small>
                </li>
            `;
        }).join('');
    }

    function categorizeCode(code) {
        if (!code || code === 'Không có mã') return 'invalid';
        if (code.startsWith('DH-') || code.startsWith('ORD-') || code.length > 5) return 'valid';
        return 'other';
    }

    function saveToHistory(codeText, sourceLabel) {
        const history = getStoredHistory();
        const now = new Date();
        const timeStr = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const category = categorizeCode(codeText);

        if (history.length > 0 && history[0].code === codeText && history[0].source === sourceLabel) return;

        history.unshift({ code: codeText, source: sourceLabel, time: timeStr, category: category });
        if (history.length > 30) history.pop();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
        renderHistory(searchHistoryInput.value);
    }

    clearHistoryBtn.addEventListener('click', function () {
        localStorage.removeItem(STORAGE_KEY);
        renderHistory();
    });

    searchHistoryInput.addEventListener('input', (e) => renderHistory(e.target.value));

    exportHistoryBtn.addEventListener('click', function () {
        const history = getStoredHistory();
        if (history.length === 0) return;
        let csvContent = "data:text/csv;charset=utf-8,MaDonHang,NguonQuet,PhanLoai,ThoiGian\n";
        history.forEach(row => {
            csvContent += `${row.code},${row.source},${row.category},${row.time}\n`;
        });
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "master_nhat_ky_qr.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

    function showAlert(title, message, type, showCopy = false, rawText = '') {
        scanResultAlert.className = `alert alert-${type} mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 rounded-3 shadow-sm`;
        alertContentText.innerHTML = `<strong>${title}</strong><br>${message}`;
        if (showCopy && rawText) {
            lastDecodedText = rawText;
            copyResultBtn.classList.remove('d-none');
        } else {
            copyResultBtn.classList.add('d-none');
        }
        scanResultAlert.classList.remove('d-none');
    }

    function processImageFile(file) {
        if (!file) return;
        if (!file.type.startsWith('image/')) {
            showAlert('⚠️ Loi dinh dang:', 'Vui long chon tep hinh anh hop le.', 'danger');
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            qrPreview.src = e.target.result;
            qrPreview.style.display = 'block';
            placeholderText.style.display = 'none';

            const sizeKB = (file.size / 1024).toFixed(1);
            fileInfoText.textContent = `Tep: ${file.name} (${sizeKB} KB)`;
            fileInfoText.classList.remove('d-none');
            clearQrBtn.disabled = false;

            const img = new Image();
            img.onload = function () {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                canvas.width = img.width;
                canvas.height = img.height;
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                if (typeof jsQR === 'function') {
                    const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });

                    if (code && code.data) {
                        playBeepSound('success');
                        saveToHistory(code.data, 'Anh');
                        qrFileStatus.textContent = 'Doc thanh cong';
                        qrFileStatus.className = 'badge bg-success text-white px-3 py-2 rounded-pill shadow-sm';
                        showAlert('✅ Giai ma QR thanh cong!', `Noi dung: <span class="badge bg-dark fs-6">${code.data}</span>`, 'success', true, code.data);
                    } else {
                        playBeepSound('error');
                        saveToHistory('Khong co ma', 'Anh');
                        qrFileStatus.textContent = 'Khong thay QR';
                        qrFileStatus.className = 'badge bg-danger text-white px-3 py-2 rounded-pill shadow-sm';
                        showAlert('❌ Khong tim thay ma QR:', 'Anh khong chua ma hoac qua mo.', 'danger', false);
                    }
                }
            };
            img.src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    function resetUI() {
        qrImageInput.value = '';
        qrPreview.src = '#';
        qrPreview.style.display = 'none';
        placeholderText.style.display = 'block';
        fileInfoText.classList.add('d-none');
        qrFileStatus.textContent = 'San sang';
        qrFileStatus.className = 'badge bg-light text-primary px-3 py-2 rounded-pill shadow-sm';
        scanResultAlert.classList.add('d-none');
        copyResultBtn.classList.add('d-none');
        clearQrBtn.disabled = true;
        lastDecodedText = '';
    }

    qrImageInput.addEventListener('change', (e) => processImageFile(e.target.files[0]));
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-primary', 'bg-light'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-primary', 'bg-light'));
    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-primary', 'bg-light');
        if (e.dataTransfer.files.length > 0) {
            qrImageInput.files = e.dataTransfer.files;
            processImageFile(e.dataTransfer.files[0]);
        }
    });
    clearQrBtn.addEventListener('click', resetUI);

    copyResultBtn.addEventListener('click', function () {
        if (lastDecodedText) {
            navigator.clipboard.writeText(lastDecodedText).then(() => {
                const orig = copyResultBtn.innerHTML;
                copyResultBtn.innerHTML = '✅ Da chep!';
                setTimeout(() => { copyResultBtn.innerHTML = orig; }, 2000);
            });
        }
    });

    function stopCamera() {
        if (cameraScanInterval) {
            clearInterval(cameraScanInterval);
            cameraScanInterval = null;
        }
        if (videoStream) {
            videoStream.getTracks().forEach(track => track.stop());
            videoStream = null;
        }
        qrVideo.classList.add('d-none');
        laserGuide.classList.add('d-none');
        cameraPlaceholder.classList.remove('d-none');
        startCamBtn.disabled = false;
        stopCamBtn.disabled = true;
        qrFileStatus.textContent = 'Da tat Cam';
        qrFileStatus.className = 'badge bg-secondary text-white px-3 py-2 rounded-pill shadow-sm';
    }

    startCamBtn.addEventListener('click', async function () {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            showAlert('⚠️ Loi Camera:', 'Trinh duyet khong ho tro Camera.', 'danger');
            return;
        }

        try {
            videoStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
            qrVideo.srcObject = videoStream;
            await qrVideo.play();

            qrVideo.classList.remove('d-none');
            laserGuide.classList.remove('d-none');
            cameraPlaceholder.classList.add('d-none');
            startCamBtn.disabled = true;
            stopCamBtn.disabled = false;
            qrFileStatus.textContent = 'Dang quet tu dong...';
            qrFileStatus.className = 'badge bg-info text-dark px-3 py-2 rounded-pill shadow-sm';

            const ctx = qrCameraCanvas.getContext('2d', { willReadFrequently: true });

            cameraScanInterval = setInterval(() => {
                if (qrVideo.readyState === qrVideo.HAVE_ENOUGH_DATA && typeof jsQR === 'function') {
                    qrCameraCanvas.width = qrVideo.videoWidth;
                    qrCameraCanvas.height = qrVideo.videoHeight;
                    ctx.drawImage(qrVideo, 0, 0, qrCameraCanvas.width, qrCameraCanvas.height);

                    const imageData = ctx.getImageData(0, 0, qrCameraCanvas.width, qrCameraCanvas.height);
                    const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });

                    if (code && code.data) {
                        playBeepSound('success');
                        saveToHistory(code.data, 'Camera');
                        qrFileStatus.textContent = 'Bat duoc ma!';
                        qrFileStatus.className = 'badge bg-success text-white px-3 py-2 rounded-pill shadow-sm';
                        showAlert('✅ Quét Webcam thành công!', `Noi dung: <span class="badge bg-dark fs-6">${code.data}</span>`, 'success', true, code.data);
                        stopCamera();
                    }
                }
            }, 250);
        } catch (err) {
            showAlert('❌ Loi Camera:', 'Khong the mo camera. Kiem tra quyen trinh duyet.', 'danger');
        }
    });

    stopCamBtn.addEventListener('click', stopCamera);
    document.getElementById('tab-image-btn').addEventListener('click', stopCamera);

    renderHistory();
});
</script>
<!-- === KẾT THÚC PHẦN 2 === -->