<!-- === BẮT ĐẦU PHẦN 2: ĐỌC MỘT ẢNH QR (NÂNG CẤP HOÀN CHỈNH) === -->
<script src="{{ url_for('static', filename='vendor/jsQR.js') }}"></script>

<div class="card shadow-sm mb-4" id="single-qr-section">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">📦 Đọc Một Ảnh QR</h5>
        <span class="badge bg-light text-primary" id="qrFileStatus">Chưa chọn tệp</span>
    </div>
    <div class="card-body">
        <!-- Vùng chọn / kéo thả ảnh QR -->
        <div id="dropZone" class="border border-2 border-dashed rounded p-3 text-center mb-3 bg-light" style="cursor: pointer; transition: 0.2s;">
            <label for="qrImageInput" class="form-label fw-bold mb-1" style="cursor: pointer;">
                Chọn hoặc kéo thả ảnh chứa mã QR vào đây
            </label>
            <p class="text-muted small mb-2">Hỗ trợ định dạng: PNG, JPG, JPEG, WEBP</p>
            <input class="form-control form-control-sm" type="file" id="qrImageInput" accept="image/png, image/jpeg, image/jpg, image/webp">
        </div>

        <!-- Khu vực hiển thị ảnh xem trước (Preview) -->
        <div class="mb-3 text-center position-relative">
            <div class="border p-2 rounded bg-white" style="min-height: 180px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
                <img id="qrPreview" src="#" alt="Ảnh xem trước QR" style="max-width: 100%; max-height: 260px; display: none; border-radius: 6px; box-shadow: 0 2px 6px rgba(0,0,0,0.1);" />
                <span id="placeholderText" class="text-muted">🖼️ Ảnh xem trước sẽ hiển thị tại đây</span>
                <small id="fileInfoText" class="text-secondary mt-2 d-none"></small>
            </div>
        </div>

        <!-- Cụm nút điều khiển -->
        <div class="d-flex gap-2 mb-3">
            <button id="scanBtn" class="btn btn-success flex-grow-1 fw-bold" disabled>
                🔍 Quét Mã QR
            </button>
            <button id="clearQrBtn" class="btn btn-outline-secondary" type="button" disabled>
                ✖ Xóa
            </button>
        </div>

        <!-- Khu vực hiển thị thông báo kết quả kèm nút Sao chép -->
        <div id="scanResultAlert" class="alert d-none mb-0 align-items-center justify-content-between flex-wrap gap-2" role="alert">
            <div id="alertContentText" class="flex-grow-1"></div>
            <button id="copyResultBtn" class="btn btn-sm btn-outline-dark d-none" type="button">📋 Sao chép</button>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const qrImageInput = document.getElementById('qrImageInput');
    const dropZone = document.getElementById('dropZone');
    const qrPreview = document.getElementById('qrPreview');
    const placeholderText = document.getElementById('placeholderText');
    const fileInfoText = document.getElementById('fileInfoText');
    const qrFileStatus = document.getElementById('qrFileStatus');
    const scanBtn = document.getElementById('scanBtn');
    const clearQrBtn = document.getElementById('clearQrBtn');
    const scanResultAlert = document.getElementById('scanResultAlert');
    const alertContentText = document.getElementById('alertContentText');
    const copyResultBtn = document.getElementById('copyResultBtn');

    let lastDecodedText = ''; // Lưu lại mã QR vừa đọc được để phục vụ tính năng sao chép

    function showAlert(title, message, type, showCopy = false, rawText = '') {
        scanResultAlert.className = `alert alert-${type} mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2`;
        alertContentText.innerHTML = `<strong>${title}</strong><br>${message}`;
        
        if (showCopy && rawText) {
            lastDecodedText = rawText;
            copyResultBtn.classList.remove('d-none');
        } else {
            copyResultBtn.classList.add('d-none');
        }
        
        scanResultAlert.classList.remove('d-none');
    }

    function handleImageFile(file) {
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            showAlert('⚠️ Lỗi định dạng tệp:', 'Vui lòng chỉ chọn tệp hình ảnh (PNG, JPG, WEBP).', 'danger');
            resetUI();
            return;
        }

        const reader = new FileReader();
        reader.onload = function (e) {
            qrPreview.src = e.target.result;
            qrPreview.style.display = 'block';
            placeholderText.style.display = 'none';

            const sizeKB = (file.size / 1024).toFixed(1);
            fileInfoText.textContent = `Tệp: ${file.name} (${sizeKB} KB)`;
            fileInfoText.classList.remove('d-none');

            qrFileStatus.textContent = 'Đã tải ảnh';
            qrFileStatus.className = 'badge bg-warning text-dark';

            scanBtn.disabled = false;
            clearQrBtn.disabled = false;
            scanResultAlert.classList.add('d-none');
            copyResultBtn.classList.add('d-none');
        };
        reader.readAsDataURL(file);
    }

    function resetUI() {
        qrImageInput.value = '';
        qrPreview.src = '#';
        qrPreview.style.display = 'none';
        placeholderText.style.display = 'block';
        fileInfoText.classList.add('d-none');
        qrFileStatus.textContent = 'Chưa chọn tệp';
        qrFileStatus.className = 'badge bg-light text-primary';
        scanBtn.disabled = true;
        clearQrBtn.disabled = true;
        scanResultAlert.classList.add('d-none');
        copyResultBtn.classList.add('d-none');
        lastDecodedText = '';
    }

    qrImageInput.addEventListener('change', function (event) {
        handleImageFile(event.target.files[0]);
    });

    dropZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        dropZone.classList.replace('bg-light', 'bg-info-subtle');
    });
    dropZone.addEventListener('dragleave', function () {
        dropZone.classList.replace('bg-info-subtle', 'bg-light');
    });
    dropZone.addEventListener('drop', function (e) {
        e.preventDefault();
        dropZone.classList.replace('bg-info-subtle', 'bg-light');
        if (e.dataTransfer.files.length > 0) {
            qrImageInput.files = e.dataTransfer.files;
            handleImageFile(e.dataTransfer.files[0]);
        }
    });

    clearQrBtn.addEventListener('click', resetUI);

    // Tính năng sao chép kết quả vào bộ nhớ tạm
    copyResultBtn.addEventListener('click', function() {
        if (lastDecodedText) {
            navigator.clipboard.writeText(lastDecodedText).then(() => {
                const originalText = copyResultBtn.innerHTML;
                copyResultBtn.innerHTML = '✅ Đã chép!';
                setTimeout(() => {
                    copyResultBtn.innerHTML = originalText;
                }, 2000);
            });
        }
    });

    scanBtn.addEventListener('click', function () {
        if (!qrPreview.src || qrPreview.style.display === 'none') {
            showAlert('⚠️ Thiếu ảnh:', 'Vui lòng chọn một ảnh trước khi bấm quét!', 'warning');
            return;
        }

        scanBtn.disabled = true;
        scanBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang giải mã...';

        const img = new Image();
        img.onload = function () {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = img.width;
            canvas.height = img.height;
            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);

            if (typeof jsQR === 'function') {
                const code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: 'dontInvert',
                });

                if (code && code.data) {
                    qrFileStatus.textContent = 'Đọc thành công';
                    qrFileStatus.className = 'badge bg-success';
                    showAlert(
                        '✅ Đọc mã QR thành công!',
                        `Nội dung: <span class="badge bg-dark fs-6">${code.data}</span>`,
                        'success',
                        true,
                        code.data
                    );
                } else {
                    qrFileStatus.textContent = 'Không thấy mã';
                    qrFileStatus.className = 'badge bg-danger';
                    showAlert(
                        '❌ Không tìm thấy mã QR:',
                        'Ảnh này không chứa mã QR hoặc mã quá mờ. Vui lòng thử ảnh khác.',
                        'danger',
                        false
                    );
                }
            } else {
                showAlert('⚠️ Lỗi hệ thống:', 'Không tải được thư viện giải mã jsQR.', 'danger', false);
            }

            scanBtn.disabled = false;
            scanBtn.innerHTML = '🔍 Quét Mã QR';
        };
        img.src = qrPreview.src;
    });
});
</script>
