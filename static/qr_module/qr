<!-- === BẮT ĐẦU PHẦN 2: ĐỌC MỘT ẢNH QR CỦA BẠN === -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">📦 Phần 2: Đọc Một Ảnh QR</h5>
    </div>
    <div class="card-body">
        <!-- Ô chọn file ảnh QR -->
        <div class="mb-3">
            <label for="qrImageInput" class="form-label">Chọn ảnh chứa mã QR đơn hàng:</label>
            <input class="form-control" type="file" id="qrImageInput" accept="image/*">
        </div>

        <!-- Ảnh xem trước (Preview) -->
        <div class="mb-3 text-center">
            <div class="border p-2 rounded bg-light" style="min-height: 150px; display: flex; align-items: center; justify-content: center;">
                <img id="qrPreview" src="#" alt="Ảnh xem trước QR" style="max-width: 100%; max-height: 250px; display: none; border-radius: 4px;" />
                <span id="placeholderText" class="text-muted">Chưa có ảnh nào được chọn</span>
            </div>
        </div>

        <!-- Nút quét mã -->
        <button id="scanBtn" class="btn btn-success w-100 mb-3">Quét Mã QR</button>

        <!-- Thông báo kết quả -->
        <div id="scanResultAlert" class="alert d-none" role="alert"></div>
    </div>
</div>

<script>
    const qrImageInput = document.getElementById('qrImageInput');
    const qrPreview = document.getElementById('qrPreview');
    const placeholderText = document.getElementById('placeholderText');
    const scanBtn = document.getElementById('scanBtn');
    const scanResultAlert = document.getElementById('scanResultAlert');

    qrImageInput.addEventListener('change', function(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                qrPreview.src = e.target.result;
                qrPreview.style.display = 'block';
                placeholderText.style.display = 'none';
            }
            reader.readAsDataURL(file);
            scanResultAlert.classList.add('d-none');
        } else {
            qrPreview.style.display = 'none';
            placeholderText.style.display = 'block';
        }
    });

    scanBtn.addEventListener('click', function() {
        const file = qrImageInput.files[0];
        if (!file) {
            showAlert('Vui lòng chọn một file ảnh QR trước khi quét!', 'warning');
            return;
        }
        scanBtn.disabled = true;
        scanBtn.innerText = 'Đang xử lý...';
        setTimeout(() => {
            showAlert('Đọc mã QR thành công! Mã đơn hàng: <strong>DH-2026-9912</strong>', 'success');
            scanBtn.disabled = false;
            scanBtn.innerText = 'Quét Mã QR';
        }, 1000);
    });

    function showAlert(message, type) {
        scanResultAlert.className = `alert alert-${type}`;
        scanResultAlert.innerHTML = message;
        scanResultAlert.classList.remove('d-none');
    }
</script>
<!-- === KẾT THÚC PHẦN 2 === -->